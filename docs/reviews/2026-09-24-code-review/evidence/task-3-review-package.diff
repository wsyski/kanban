+        return None, None
+    except (OSError, ValueError) as e:
+        return None, ("ERROR", code, f"{what} is not readable JSON ({e})")
+    if not isinstance(value, dict):
+        return None, ("ERROR", code, f"{what} is not a JSON object "
+                                     f"(got {type(value).__name__})")
+    return value, None
