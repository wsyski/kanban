build/
target/
# boards/<slug>/ IS tracked for its DEFINITION (board.json, lane-<k>.md, README).
# Everything a RUN generates is scratch: work/ is results-scratch, runs/ is
# per-run state + intermediate hand-offs (refined idea, plan). None of it is
# committed — provenance lives in per-card patch attachments, not in git.
boards/*/work/
boards/*/runs/
__pycache__/
*.pyc

# IDE
.idea/
.classpath
.project
.settings/
