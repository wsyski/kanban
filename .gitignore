build/
target/
# boards/<slug>/ IS tracked, work/ included: the board's deliverable is what the
# humans commit at the gates, and an ignored path cannot be staged or attached —
# the hand-off would fail at the first lane. Only the driver's own run state is
# ignored. Build output under work/ is covered by target/ and build/ above.
boards/*/runs/
__pycache__/
*.pyc

# IDE
.idea/
.classpath
.project
.settings/
